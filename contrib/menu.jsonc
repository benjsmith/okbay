{
  "okbay": { "label": "OKBay", "icon": "󰑷" },
  "okbay.atlas": { "label": "Atlas", "command": ["sh", "-lc", "~/.config/omarchy/plugins/benjsmith.okbay/contrib/okbay-open-atlas.sh"] },
  "okbay.library": { "label": "Library", "command": ["sh", "-lc", "OKBAY_ATLAS_URL=http://127.0.0.1:8766/atlas#view=library ~/.config/omarchy/plugins/benjsmith.okbay/contrib/okbay-open-atlas.sh"] },
  "okbay.ingest": { "label": "Ingest clipboard path", "command": ["okbay", "ingest", "--selection"] },
  "okbay.ask": { "label": "Ask the graph", "command": ["okbay", "ask", "--prompt"] }
}
