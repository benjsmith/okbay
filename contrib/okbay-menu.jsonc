{
  "Okbay": [
    { "label": "Atlas",   "action": "~/.config/omarchy/plugins/benjsmith.okbay/contrib/okbay-open-atlas.sh" },
    { "label": "Library", "action": "env OKBAY_ATLAS_URL=http://127.0.0.1:8766/atlas#view=library ~/.config/omarchy/plugins/benjsmith.okbay/contrib/okbay-open-atlas.sh" },
    { "label": "Reviews", "action": "omarchy-shell shell summon benjsmith.okbay '{\"surface\":\"panel\"}'" },
    { "label": "Ask",     "action": "okbay ask --prompt" },
    { "label": "Curate",  "action": "okbay desk start curate" },
    { "label": "Work",    "action": "okbay desk start work" },
    { "label": "Code",    "action": "okbay desk start code" },
    { "label": "Status",  "action": "okbay status" }
  ]
}
